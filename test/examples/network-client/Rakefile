require 'fileutils'

BUILD_DIR = 'build'
OUTPUT = File.join(BUILD_DIR, 'nc')

desc 'Build fixture artifacts'
task :build do
  FileUtils.mkdir_p(BUILD_DIR)
  sh 'gcc', '-O2', '-s', 'nc.c', '-o', OUTPUT
  puts "Build complete: #{OUTPUT}"
end

desc 'Remove build outputs'
task :clean do
  FileUtils.rm_rf(BUILD_DIR)
  puts 'Cleanup complete.'
end
